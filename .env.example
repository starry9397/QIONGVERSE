# Public, non-secret Vite build value. Must be the deployed HTTPS origin without a trailing slash.
VITE_PUBLIC_SITE_URL=https://your-public-domain.example

# Required only when the frontend and API use different HTTPS origins.
VITE_LUOYIN_API_BASE_URL=

# Bind the Node service only to loopback when Caddy and the service share a VPS.
LUOYIN_SERVER_HOST=127.0.0.1
LUOYIN_SERVER_PORT=8787
LUOYIN_TRUST_PROXY=1
LUOYIN_ALLOWED_ORIGINS=

# Server-only Luoyin model credential. Inject the real value through the process
# environment or a deployment secret manager; never expose it to Vite or commit it.
GLM_API_KEY=
# Optional server-only override. The deployed model is fixed in server.mjs to GLM-4.6V-Flash.
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# Optional server-only TTS adapter. Leave empty to keep the guide text-only;
# the client never falls back to browser speech synthesis.
# The configured provider must return audio bytes or { audioBase64, mimeType }.
LUOYIN_TTS_API_URL=
LUOYIN_TTS_API_KEY=
LUOYIN_TTS_VOICE_ID=
# Non-secret provider preset; the server also sends the fixed Luoyin voice direction.
LUOYIN_TTS_VOICE_STYLE=sweet-playful-storybook

# Server-only social OAuth configuration. Set actual values only in the deployment secret manager.
SOCIAL_PUBLIC_BASE_URL=https://your-public-domain.example
SOCIAL_CALLBACK_BASE_URL=https://your-api-domain.example
SOCIAL_OAUTH_STATE_SECRET=replace-with-a-random-32-character-or-longer-secret
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
