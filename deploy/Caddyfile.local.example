# Local-only validation profile. It intentionally does not claim public HTTPS.
:8080 {
	encode gzip

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * D:/Codex/home/worktrees/5b5b/网页开发2/dist
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
