# Replace PUBLIC_DOMAIN with the registered apex domain before installation.
# Keep the www redirect block before the canonical site block.

www.PUBLIC_DOMAIN {
	redir https://PUBLIC_DOMAIN{uri} permanent
}

PUBLIC_DOMAIN {
	encode gzip zstd

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		root * /srv/qiongverse/current/dist
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
